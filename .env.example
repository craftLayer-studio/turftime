# Copy to .env.local and adjust. Never commit real secrets.

# Base URL used in QR codes, WhatsApp links and share links.
# Production: https://turftime.craftlayer.store
APP_URL=http://localhost:3131

# Signs the staff/owner session cookie. At least 32 random characters.
# Without it a dev fallback is used and a warning is logged.
SESSION_SECRET=

# Optional: use a real Postgres instead of the local PGlite file DB (./.data/pglite).
# DATABASE_URL=postgres://user:password@localhost:5432/turftime

# Demo mode shows the sign-in OTP on screen (labelled demo). Set to 0 to hide it.
DEMO_MODE=1
